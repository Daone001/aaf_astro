---
import Navbar from '../components/Navbar.astro';
import Layout from '../layouts/Layout.astro';
import ProfileCardBtnImg from '../components/ProfileCardBtnImg.astro';
import Search from '../components/Search.astro';
import Showcase from '../components/Showcase.astro';
import { getCollection } from 'astro:content';

// const Profiles = await Astro.glob('../members/*.md');
const allMembers = await getCollection('members');
---

<Layout title="AAF law member profiles">
  <Navbar showcase={false} />
  <Showcase title="The Team" />
  <!-- <Search members="allMembers" /> -->

  <div class="row-between-2">
    {
      allMembers.map((member) => (
        <ProfileCardBtnImg
          title={member.data.title}
          picture={member.data.picture}
          body={member.data.excerpt}
          href={`/${member.data.slug}`}
        />
      ))
    }
  </div>
</Layout>
