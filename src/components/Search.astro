import ProfileCardBtnImg from './ProfileCardBtnImg.astro';
import { getCollection } from 'astro:content';
const filteredPosts = await getCollection('members', ({ data }) => {
  return data;
});
const query = Astro.url.searchParams.get('q');
const searchResults = filteredPosts.filter((profile) =>
  profile.data.title.includes(query),
);

const { query, searchResults } = Astro.props;
---

<input type="text" id="searchInput" placeholder="Search for team member..." />
<ul id="teamList"></ul>

